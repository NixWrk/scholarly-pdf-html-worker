{
  "description": "Default gates for LLM-assisted EN polish experiments. Metrics listed here are expected to be lower-is-better, so positive deltas fail the gate.",
  "allow_missing_previous": true,
  "require_article_review_stage": true,
  "article_review_bundle_max_articles": 0,
  "max_pending_mandatory_reviews": 0,
  "require_pdf_text_layer_diagnostics": true,
  "require_pdf_problem_evidence_stage": true,
  "pdf_problem_evidence_max_articles": 12,
  "pdf_problem_evidence_max_pdf_pages": 80,
  "pdf_problem_evidence_render_zoom": 1.5,
  "pdf_problem_evidence_allow_missing_source_pdf": true,
  "require_p62_marker_recovery_plan": true,
  "p62_marker_recovery_max_articles": 0,
  "p62_marker_recovery_max_pdf_pages": 80,
  "p62_marker_recovery_context_chars": 5000,
  "p62_marker_recovery_min_match_score": 0.05,
  "p62_marker_recovery_require_label_match": true,
  "p62_marker_recovery_retry_full_pdf_on_label_miss": true,
  "run_p62_image_recovery_stage": true,
  "p62_image_recovery_max_articles": 0,
  "p62_image_recovery_execute_marker": true,
  "p62_image_recovery_apply_patches": true,
  "p62_image_recovery_rerun_audit": true,
  "p62_image_recovery_render_zoom": 1.5,
  "p62_image_recovery_marker_timeout_seconds": 600,
  "p62_image_recovery_probe_source_visual_unavailable": true,
  "p62_image_recovery_probe_marker_for_unavailable": true,
  "p62_image_recovery_source_visual_probe_marker_timeout_seconds": 600,
  "p62_image_recovery_replace_page_render": true,
  "p62_image_recovery_remove_false_match_recovery": true,
  "p62_image_recovery_repair_duplicate_figure_images": true,
  "ignored_defect_ids_for_analysis": ["P13", "P16", "P20", "P61", "P62"],
  "max_regressions": 0,
  "max_total_deltas": {
    "score": 0,
    "defects": 0,
    "errors": 0,
    "broken_internal_links": 0,
    "external_page_query_links": 0,
    "internal_page_anchor_links": 0,
    "mixed_citation_style": 0,
    "polish_replacement_chars": 0,
    "table_units_with_section_ids": 0
  },
  "max_article_deltas": {
    "score_delta": 0,
    "defects_delta": 0,
    "errors_delta": 0
  },
  "required_test_command": "python -m pytest -q"
}
